{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "extract": "deno run -A clinergy-extract.ts",
    "map": "deno run -A clinergy-to-opengalen.ts",
    "mcp": "deno run --allow-read --allow-env mcp/opengalen-mcp.ts",
    "wine": "deno run -A clinergy-wine.ts",
    "sentence": "deno run -A src/sentence-cli.ts",
    "openehr": "deno run -A src/openehr-cli.ts",
    "snomed": "deno run -A src/snomed-cli.ts",
    "fhir": "deno run -A src/fhir-cli.ts",
    "test": "deno test -A",
    "check": "deno check *.ts src/*.ts mcp/*.ts tests/*.ts"
  },
  "fmt": {
    "lineWidth": 120
  },
  "exclude": [
    "out/",
    "map/"
  ]
}
